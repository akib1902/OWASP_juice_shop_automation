# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored — never commit real secrets.
# Every value below also has a safe default in src/config/env.js, so the suite
# runs out of the box against `docker run -p 3000:3000 bkimminich/juice-shop`.
# ---------------------------------------------------------------------------

# Origin of the application under test (UI).
BASE_URL=http://localhost:3000

# Origin of the API. Omit to reuse BASE_URL.
# API_URL=http://localhost:3000

# Seeded admin account (ships with the Juice Shop container).
ADMIN_EMAIL=admin@juice-sh.op
ADMIN_PASSWORD=admin123

# Password assigned to every throw-away customer registered by the suite.
DEFAULT_PASSWORD=P@ssw0rd!123

# Execution tuning.
# HEADED=true          # run browsers visibly
# WORKERS=4            # parallel workers (default: CPU cores)
# RETRIES=0            # retries on failure (default: 0 local, 2 in CI)
# TEST_TIMEOUT=60000
# EXPECT_TIMEOUT=10000
